<Page
    x:Class="StudyAgent_Windows.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20">

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="AboutTitle"
                    Text="О программе"
                    Style="{StaticResource TitleTextBlockStyle}"/>

                <TextBlock
                    x:Name="AboutSubtitle"
                    Text="Study Agent — локальный помощник для работы с учебными материалами."
                    TextWrapping="Wrap"
                    Opacity="0.75"/>
            </StackPanel>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Study Agent"
                        FontSize="24"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="VersionLabel"
                        Text="Версия"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="VersionValue"
                        Text="—"/>

                    <TextBlock
                        x:Name="DescriptionText"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        x:Name="PrivacyText"
                        TextWrapping="Wrap"
                        Opacity="0.75"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
