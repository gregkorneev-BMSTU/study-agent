<Page
    x:Class="StudyAgent_Windows.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel Padding="32" Spacing="20">

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="SearchTitle" Text="Поиск по учебным материалам"
                    Style="{StaticResource TitleTextBlockStyle}"/>

                <TextBlock
                    x:Name="SearchSubtitle" Text="Поиск документов и ответы на вопросы"
                    Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="QueryInput"
                    Grid.Column="0"
                    PlaceholderText="Введите вопрос или поисковый запрос..."
                    KeyDown="QueryInput_KeyDown"/>

                <Button
                    x:Name="SearchButton"
                    Grid.Column="1"
                    Content="Найти"
                    Click="SearchButton_Click"/>
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="ModelHeading" Text="Локальная языковая модель"
                    FontWeight="SemiBold"/>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10">

                    <ComboBox
                        x:Name="ModelsComboBox"
                        Width="260"
                        PlaceholderText="Модель не выбрана"/>

                    <Button
                        x:Name="RefreshModelsButton"
                        Content="Обновить модели"
                        Click="RefreshModelsButton_Click"/>

                    <Button
                        x:Name="GenerateButton"
                        Content="Сгенерировать ответ"
                        IsEnabled="False"
                        Click="GenerateButton_Click"/>
                </StackPanel>

                <TextBlock
                    x:Name="OllamaStatus"
                    Text="Нажмите «Обновить модели», чтобы проверить Ollama."
                    TextWrapping="Wrap"
                    Opacity="0.75"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="AnswerHeading" Text="Ответ по найденным материалам"
                    FontSize="18"
                    FontWeight="SemiBold"/>

                <Border
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="14">

                    <TextBlock
                        x:Name="AnswerText"
                        Text="После поиска выберите модель и нажмите «Сгенерировать ответ»."
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"/>
                </Border>
            </StackPanel>

            <StackPanel Spacing="6">
                <ProgressRing
                    x:Name="SearchProgress"
                    Width="26"
                    Height="26"
                    IsActive="False"
                    HorizontalAlignment="Left"/>

                <TextBlock
                    x:Name="SearchStatus"
                    Text="Введите запрос для поиска."
                    TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel
                x:Name="ResultsPanel"
                Spacing="12"/>



        </StackPanel>
    </ScrollViewer>
</Page>
