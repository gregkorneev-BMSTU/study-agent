<Page
    x:Class="StudyAgent_Windows.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock
                Text="Поиск по учебным материалам"
                Style="{StaticResource TitleTextBlockStyle}"/>

            <TextBlock
                Text="Поиск документов и ответы на вопросы"
                Style="{StaticResource BodyTextBlockStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="QueryInput"
                Grid.Column="0"
                PlaceholderText="Введите вопрос или поисковый запрос..."
                KeyDown="QueryInput_KeyDown"/>

            <Button
                x:Name="SearchButton"
                Grid.Column="1"
                Content="Найти"
                Click="SearchButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="Локальная языковая модель"
                       FontWeight="SemiBold"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox
                    x:Name="ModelsComboBox"
                    Width="260"
                    PlaceholderText="Модель не выбрана"/>

                <Button
                    x:Name="RefreshModelsButton"
                    Content="Обновить модели"
                    Click="RefreshModelsButton_Click"/>

                <Button
                    x:Name="GenerateButton"
                    Content="Сгенерировать ответ"
                    IsEnabled="False"
                    Click="GenerateButton_Click"/>
            </StackPanel>

            <TextBlock
                x:Name="OllamaStatus"
                Text="Нажмите «Обновить модели», чтобы проверить Ollama."
                TextWrapping="Wrap"
                Opacity="0.75"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="6">
            <ProgressRing
                x:Name="SearchProgress"
                Width="26"
                Height="26"
                IsActive="False"
                HorizontalAlignment="Left"/>

            <TextBlock
                x:Name="SearchStatus"
                Text="Введите запрос для поиска."
                TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="ResultsPanel"
                Spacing="12"/>
        </ScrollViewer>

        <StackPanel Grid.Row="5" Spacing="8">
            <TextBlock Text="Ответ по найденным материалам"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            <Border
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                CornerRadius="8"
                Padding="14">
                <ScrollViewer MaxHeight="150"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="AnswerText"
                        Text="После поиска выберите модель и нажмите «Сгенерировать ответ»."
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</Page>
