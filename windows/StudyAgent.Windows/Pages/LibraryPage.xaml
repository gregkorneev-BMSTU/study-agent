<Page
    x:Class="StudyAgent_Windows.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32">
        <StackPanel Spacing="18">

            <TextBlock
                x:Name="LibraryTitle" Text="Библиотека"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock
                x:Name="LibrarySubtitle" Text="Подключённые учебные материалы"
                Style="{StaticResource BodyTextBlockStyle}" />

            <Button
                x:Name="AddFolderButton"
                Click="AddFolderButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock
                        x:Name="AddFolderLabel" Text="Добавить папку"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckChangesButton" Content="Проверить изменения"
                    Click="CheckChangesButton_Click" />
                <Button x:Name="CancelIndexButton" Content="Отменить"
                    IsEnabled="False" Click="CancelIndexButton_Click" />
            </StackPanel>

            <ProgressRing
                x:Name="LoadingIndicator"
                IsActive="False"
                Width="28"
                Height="28"
                HorizontalAlignment="Left" />

            <TextBlock
                x:Name="LibraryStatus"
                Text="Добавьте папку с учебными материалами."
                TextWrapping="Wrap" />

            <ProgressBar x:Name="IndexProgress" Minimum="0" Maximum="100"
                Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="InstallOcrButton" Content="Установить веса OCR" IsEnabled="False"
                    Click="InstallOcrButton_Click" />
                <ProgressRing x:Name="OcrProgress" Width="24" Height="24"
                    IsActive="False" />
            </StackPanel>

            <ListView
                x:Name="SourcesList"
                MinHeight="120"
                MaxHeight="320" />

            <Button
                x:Name="DiagnoseButton"
                Content="Проверить Python-backend"
                Click="DiagnoseButton_Click"
                HorizontalAlignment="Left" />

            <TextBlock
                x:Name="BackendStatus"
                TextWrapping="Wrap" />

        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
