<Page
    x:Class="StudyAgent_Windows.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32" Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">

            <TextBlock
                x:Name="LibraryTitle" Text="Библиотека"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock
                x:Name="LibrarySubtitle" Text="Подключённые учебные материалы"
                Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Opacity="0.75" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <Button x:Name="AddFolderButton" Click="AddFolderButton_Click"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock x:Name="AddFolderLabel" Text="Добавить папку"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CheckChangesButton" Content="Проверить изменения"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="CheckChangesButton_Click" />
                    <Button x:Name="CancelIndexButton" Content="Отменить"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        IsEnabled="False" Click="CancelIndexButton_Click" />
                    <ProgressRing x:Name="LoadingIndicator" IsActive="False"
                        Width="28" Height="28" HorizontalAlignment="Left" />
                    <TextBlock x:Name="LibraryStatus"
                        Text="Добавьте папку с учебными материалами." TextWrapping="Wrap" />
                    <ProgressBar x:Name="IndexProgress" Minimum="0" Maximum="100"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <ListView
                x:Name="SourcesList"
                MinHeight="120"
                MaxHeight="480" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <Button x:Name="InstallOcrButton" Content="Установить веса OCR" IsEnabled="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="InstallOcrButton_Click" />
                    <ProgressRing x:Name="OcrProgress" Width="24" Height="24"
                        HorizontalAlignment="Left" IsActive="False" />
                    <Button x:Name="DiagnoseButton" Content="Проверить Python-backend"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="DiagnoseButton_Click" />
                    <TextBlock x:Name="BackendStatus" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
