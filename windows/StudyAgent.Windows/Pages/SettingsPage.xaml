<Page
    x:Class="StudyAgent_Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="24">

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="SettingsTitle"
                    Text="Настройки"
                    Style="{StaticResource TitleTextBlockStyle}"/>

                <TextBlock
                    x:Name="SettingsSubtitle"
                    Text="Настройте Study Agent под свои предпочтения."
                    TextWrapping="Wrap"
                    Opacity="0.7"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="LanguageHeading"
                    Text="Язык интерфейса"
                    FontSize="18"
                    FontWeight="SemiBold"/>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">

                    <ComboBox
                        x:Name="LanguageCombo"
                        Header="Язык"
                        MinWidth="200"
                        SelectionChanged="LanguageCombo_SelectionChanged">

                        <ComboBoxItem Content="Русский"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock x:Name="AccessibilityHeading" Text="Доступность Windows"
                    FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="AccessibilityDescription" TextWrapping="Wrap"
                    Text="Повышенную контрастность и уменьшение движения можно настроить системными средствами Windows." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ContrastButton" Content="Повышенная контрастность"
                        Click="ContrastButton_Click" />
                    <Button x:Name="MotionButton" Content="Уменьшение движения"
                        Click="MotionButton_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock x:Name="SetupHeading" Text="Первоначальная настройка"
                    FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="SetupDescription" TextWrapping="Wrap"
                    Text="Откройте мастер приветствия и перейдите к диагностике компонентов в Библиотеке." />
                <Button x:Name="ReplayWelcomeButton" Content="Открыть мастер настройки"
                    HorizontalAlignment="Left" Click="ReplayWelcomeButton_Click" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="AppearanceHeading"
                    Text="Внешний вид и доступность"
                    FontSize="18"
                    FontWeight="SemiBold"/>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="ThemeHeading"
                                Text="Цветовая тема"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                x:Name="ThemeDescription"
                                Text="Выберите оформление приложения."
                                TextWrapping="Wrap"
                                Opacity="0.7"/>
                        </StackPanel>

                        <ComboBox
                            x:Name="ThemeCombo"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="ThemeCombo_SelectionChanged">

                            <ComboBoxItem
                                x:Name="SystemThemeItem"
                                Content="Системная"/>

                            <ComboBoxItem
                                x:Name="LightThemeItem"
                                Content="Светлая"/>

                            <ComboBoxItem
                                x:Name="DarkThemeItem"
                                Content="Тёмная"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenOllamaButton" Content="Установить Ollama"
                        Click="OpenOllamaButton_Click" />
                    <Button x:Name="InstallModelButton" Content="Установить рекомендованную модель"
                        Click="InstallModelButton_Click" />
                    <Button x:Name="CancelModelButton" Content="Отменить"
                        IsEnabled="False" Click="CancelModelButton_Click" />
                </StackPanel>
                <ProgressBar x:Name="ModelInstallProgress" Minimum="0" Maximum="100"
                    Visibility="Collapsed" />
                <TextBlock x:Name="ModelInstallStatus" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="ModelHeading"
                    Text="Локальная языковая модель"
                    FontSize="18"
                    FontWeight="SemiBold"/>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">

                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="Ollama"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            x:Name="ModelDescription"
                            Text="Для генерации ответов используется локальная Ollama. Выбрать установленную модель пока можно на странице поиска."
                            TextWrapping="Wrap"
                            Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="PrivacyHeading"
                    Text="Конфиденциальность"
                    FontSize="18"
                    FontWeight="SemiBold"/>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="PrivacySubheading"
                            Text="Локальная обработка"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            x:Name="PrivacyDescription"
                            Text="Study Agent обрабатывает выбранные учебные материалы на компьютере. Для генерации ответа вопрос и найденные выдержки передаются локальному серверу Ollama."
                            TextWrapping="Wrap"
                            Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
